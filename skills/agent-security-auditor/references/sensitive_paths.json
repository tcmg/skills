{
  "_comment": "Paths an AI coding agent should never need to read. '~' is the user's home. Used by scan_agent_security.py to test sandbox/deny coverage and to build proposed deny lists. Only paths that exist on the machine are reported.",
  "credentials": [
    "~/.ssh",
    "~/.aws",
    "~/.azure",
    "~/.config/gcloud",
    "~/.config/gh",
    "~/.config/op",
    "~/.config/hub",
    "~/.kube",
    "~/.docker/config.json",
    "~/.gnupg",
    "~/.netrc",
    "~/.git-credentials",
    "~/.npmrc",
    "~/.pypirc",
    "~/.gem/credentials",
    "~/.cargo/credentials.toml",
    "~/.cargo/credentials",
    "~/.android/adbkey",
    "~/.m2/settings.xml",
    "~/.m2/settings-security.xml",
    "~/.gradle/gradle.properties",
    "~/.terraform.d/credentials.tfrc.json",
    "~/.config/firebase",
    "~/.config/configstore/firebase-tools.json",
    "~/.vault-token",
    "~/.cache/huggingface/token",
    "~/.huggingface/token",
    "~/.password-store",
    "~/Library/Keychains"
  ],
  "agent_secrets": [
    "~/.claude/.credentials.json",
    "~/.gemini/oauth_creds.json",
    "~/.gemini/google_accounts.json",
    "~/.gemini/antigravity-cli/antigravity-oauth-token",
    "~/.gemini/antigravity/mcp_oauth_tokens.json",
    "~/Library/Application Support/Antigravity IDE/User/globalStorage",
    "~/Library/Application Support/Antigravity/User/globalStorage",
    "~/Library/Application Support/Claude/config.json",
    "~/.config/anthropic",
    "~/.codex/auth.json"
  ],
  "personal": [
    "~/Documents",
    "~/Desktop",
    "~/Downloads",
    "~/Pictures",
    "~/Movies",
    "~/Music",
    "~/Library/Mobile Documents",
    "~/Library/CloudStorage",
    "~/Dropbox",
    "~/Google Drive",
    "~/OneDrive",
    "~/Library/Messages",
    "~/Library/Mail",
    "~/Library/Calendars",
    "~/Library/Application Support/AddressBook",
    "~/Library/Notes",
    "~/Library/Group Containers/group.com.apple.notes"
  ],
  "browsers_and_password_managers": [
    "~/Library/Application Support/Google/Chrome",
    "~/Library/Application Support/BraveSoftware",
    "~/Library/Application Support/Microsoft Edge",
    "~/Library/Application Support/Arc",
    "~/Library/Application Support/Firefox",
    "~/Library/Safari",
    "~/Library/Containers/com.apple.Safari",
    "~/Library/Group Containers/2BUA8C4S2C.com.1password",
    "~/Library/Application Support/1Password",
    "~/Library/Application Support/Bitwarden"
  ],
  "agent_config_tamper_targets": {
    "_comment": "Config that, if an agent could WRITE it, lets that agent (or another agent) weaken its own guardrails.",
    "claude": [
      "~/.claude/settings.json",
      "~/.claude/settings.local.json",
      "~/.claude.json",
      "~/.claude/CLAUDE.md",
      "~/.claude/hooks",
      "~/.claude/skills",
      "~/.claude/agents",
      "~/.claude/commands"
    ],
    "antigravity": [
      "~/.gemini/config/config.json",
      "~/.gemini/config/mcp_config.json",
      "~/.gemini/config/hooks.json",
      "~/.gemini/config/projects",
      "~/.gemini/config/plugins",
      "~/.gemini/config/sidecars",
      "~/.gemini/config/rules",
      "~/.gemini/GEMINI.md",
      "~/.gemini/AGENTS.md",
      "~/.gemini/settings.json",
      "~/.gemini/trustedFolders.json",
      "~/.gemini/antigravity/mcp_config.json",
      "~/.gemini/antigravity-cli/settings.json"
    ],
    "shell_startup": [
      "~/.zshrc",
      "~/.zprofile",
      "~/.zshenv",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.profile",
      "~/.gitconfig",
      "~/Library/LaunchAgents"
    ]
  },
  "toolchain_read_allowlist": {
    "_comment": "Home-directory paths that dev tools commonly need to READ even when the rest of home is denied. The scanner only proposes the ones that exist.",
    "paths": [
      "~/.gitconfig",
      "~/.config/git",
      "~/.gitignore_global",
      "~/.npm",
      "~/.nvm",
      "~/.volta",
      "~/.fnm",
      "~/.bun",
      "~/.deno",
      "~/.yarn",
      "~/.pnpm-store",
      "~/Library/pnpm",
      "~/.cargo/bin",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.rustup",
      "~/go",
      "~/.pyenv",
      "~/.rbenv",
      "~/.asdf",
      "~/.local/share/mise",
      "~/.local/bin",
      "~/.local/share/uv",
      "~/.local/pipx",
      "~/miniconda3",
      "~/anaconda3",
      "~/miniforge3",
      "~/.conda",
      "~/.condarc",
      "~/.cache/uv",
      "~/.cache/pip",
      "~/.cache/pre-commit",
      "~/.cache/yarn",
      "~/.cache/node",
      "~/.cache/deno",
      "~/.cache/go-build",
      "~/.cache/ms-playwright",
      "~/.cache/pypoetry",
      "~/Library/Caches/Homebrew",
      "~/Library/Caches/pip",
      "~/Library/Caches/node-gyp",
      "~/Library/Caches/typescript",
      "~/Library/Caches/go-build",
      "~/Library/Caches/ms-playwright",
      "~/Library/Caches/ms-playwright-go",
      "~/Library/Caches/electron",
      "~/Library/Caches/Yarn",
      "~/Library/Caches/pnpm",
      "~/Library/Caches/deno",
      "~/Library/Caches/pypoetry",
      "~/Library/Caches/org.swift.swiftpm",
      "~/Library/Caches/com.apple.dt.Xcode",
      "~/Library/Caches/com.apple.dt.xcodebuild",
      "~/Library/Caches/Godot",
      "~/.gradle/caches",
      "~/.gradle/wrapper",
      "~/.m2/repository",
      "~/.sdkman",
      "~/.android/debug.keystore",
      "~/.android/avd",
      "~/.android/cache",
      "~/Library/Android/sdk",
      "~/Library/Developer",
      "~/.swiftpm",
      "~/.cocoapods",
      "~/.expo",
      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.claude/shell-snapshots",
      "~/.claude/session-env",
      "~/.agents",
      "~/.gemini/config/skills",
      "~/.gemini/antigravity/builtin"
    ],
    "_note": "In Claude Code's sandbox an allowRead entry takes precedence over denyRead for every path under it, so never allow a broad folder (~/.cache, ~/Library/Caches) that also holds browser caches or tokens - list the specific tool caches instead."
  }
}
